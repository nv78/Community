# Local API server (development only)
REACT_APP_API_ENDPOINT=http://localhost:5000

# Stripe publishable key (get from Stripe dashboard)
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Set by CI/CD secrets — not needed for local dev
# REACT_APP_BACK_END_HOST=
# REACT_APP_FRONT_END_HOST=

# Google API keys for the Armor pages (Sheets + Calendar reads).
# Restrict each key in Google Cloud Console: HTTP referrers = your site, APIs = Sheets / Calendar only.
REACT_APP_GOOGLE_SHEETS_API_KEY=
REACT_APP_GOOGLE_CALENDAR_API_KEY=
